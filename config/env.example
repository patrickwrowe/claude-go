# claude-go configuration. install.sh copies this to ~/.config/claude-go/env (mode 600).
# Secrets live only in that copy; never commit it.

# --- required ---
OPENCODE_GO_API_KEY=
# Local key Claude Code uses to authenticate to the proxy (generated by install.sh).
LITELLM_MASTER_KEY=

# --- upstream / proxy ---
# OPENCODE_GO_BASE=https://opencode.ai/zen/go
# CLAUDE_GO_PORT=4141

# --- model tiers: which Go model answers each Claude Code alias ---
# CLAUDE_GO_MODEL=minimax-m3            # model at startup (override per run with --model)
# CLAUDE_GO_OPUS_MODEL=kimi-k2.7-code   # /model opus, plan mode, opus-tier subagents
# CLAUDE_GO_SONNET_MODEL=minimax-m3     # /model sonnet, sonnet-tier subagents
# CLAUDE_GO_HAIKU_MODEL=qwen3.8-flash   # background tasks (titles, summaries), Explore agent
# CLAUDE_GO_SUBAGENT_MODEL=             # force every subagent/teammate onto one model

# --- Claude Code behaviour ---
# Compact earlier if a model's real context window is smaller than Claude Code assumes.
# CLAUDE_GO_COMPACT_WINDOW=120000
# Separate Claude Code config dir for claude-go sessions (default ~/.claude-go).
# Setting this to ~/.claude shares everything with your subscription setup,
# including any model you pick with /model. Not recommended.
# CLAUDE_GO_CONFIG_DIR=$HOME/.claude-go
