#!/usr/bin/env bash
# claude-go: Claude Code, running on OpenCode Go models via a local LiteLLM proxy.
#
# Every argument after the leading claude-go flags (--once, --no-once) is passed
# straight to `claude`, so anything that works there works here:
#   claude-go                          # interactive, default model
#   claude-go --model kimi-k2.7-code   # pick any model from `claude-go-ctl models`
#   claude-go -p "explain this repo"   # headless
#   claude-go --resume
#   claude-go --once                   # stop the proxy on exit (for one-shot -p workflows)
#
# By default the proxy is left running so subsequent `claude-go` calls reuse it
# ("starts on demand"). With --once, or CLAUDE_GO_STOP_ON_EXIT=1, the proxy is
# stopped when `claude` returns -- handy for CI and one-shot -p runs. A proxy
# that was already running (and may be serving other sessions) is left alone.
#
# Plain `claude` is untouched and keeps using your Anthropic subscription.
set -euo pipefail

# Locate the repo (this file may be a symlink in ~/.local/bin).
cg_self="${BASH_SOURCE[0]}"
while [ -L "$cg_self" ]; do
  cg_d="$(cd -P "$(dirname "$cg_self")" && pwd)"; cg_self="$(readlink "$cg_self")"
  [[ $cg_self != /* ]] && cg_self="$cg_d/$cg_self"
done
CG_REPO="$(cd -P "$(dirname "$cg_self")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$CG_REPO/lib/common.sh"

# Our own flags must come first; everything from the first other argument on is
# claude's, so e.g. `claude-go -p --once` still sends "--once" as the prompt.
stop_on_exit="${CLAUDE_GO_STOP_ON_EXIT:-0}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --once)    stop_on_exit=1 ;;
    --no-once) stop_on_exit=0 ;;
    *)         break ;;
  esac
  shift
done

# claude-go's guardrails reach Claude Code as one --settings flag (see below).
# Claude Code keeps only the last --settings it is given, so a second one would
# silently discard them.
cg_refuse_bypass() {
  cg_err "bypassPermissions mode is disabled for claude-go (config/claude-settings.json): it would let a Go model"
  cg_err "run every command unasked. Claude Code would silently fall back to prompting, which hangs unattended runs."
  cg_err "grant what the session needs with permissions.allow in ~/.claude-go/settings.json (e.g. with --permission-mode dontAsk)."
  exit 2
}
prev=""
for a in "$@"; do
  case "$a" in
    --bare|--safe-mode)
      cg_err "$a turns off hooks, plugins and CLAUDE.md, which removes claude-go's mandatory skill and your project's instructions."
      cg_err "run plain \`claude $a\` if you need it."
      exit 2 ;;
    --) break ;;
    --settings|--settings=*)
      cg_err "claude-go already passes --settings (config/claude-settings.json); a second one would replace it."
      cg_err "put personal settings in ~/.claude-go/settings.json (or \$CLAUDE_GO_CONFIG_DIR/settings.json) instead."
      exit 2 ;;
    --dangerously-skip-permissions|--allow-dangerously-skip-permissions|--permission-mode=bypassPermissions)
      cg_refuse_bypass ;;
  esac
  [[ $prev == --permission-mode && $a == bypassPermissions ]] && cg_refuse_bypass
  prev="$a"
done
# What --bare / --safe-mode set; either one alone has the same effect.
for v in CLAUDE_CODE_SIMPLE CLAUDE_CODE_SAFE_MODE; do
  if [[ -n ${!v:-} && ${!v} != 0 ]]; then
    cg_err "$v is set: it turns off hooks, plugins and CLAUDE.md, which removes claude-go's mandatory skill. Unset it."
    exit 2
  fi
done
[[ -r $CG_REPO/claude/plugins/claude-go/skills/claude-go/SKILL.md ]] \
  || { cg_err "missing $CG_REPO/claude/plugins/claude-go (the mandatory claude-go skill)"; exit 1; }

cg_load_env
if [[ $stop_on_exit == 1 ]]; then
  # Set before starting so Ctrl-C during startup doesn't leave the proxy behind.
  # The EXIT trap also runs when we're killed by SIGINT/SIGTERM.
  trap '[[ ${CG_PROXY_STARTED:-0} == 1 ]] && cg_proxy_stop >/dev/null 2>&1; true' EXIT
fi
cg_proxy_start "$CG_REPO"

claude_bin="${CLAUDE_GO_CLAUDE_BIN:-$(command -v claude || true)}"
[[ -n $claude_bin ]] || { cg_err "claude (Claude Code) not found on PATH"; exit 1; }

# --- route Claude Code to the proxy ---
export ANTHROPIC_BASE_URL="$CG_URL"
export ANTHROPIC_AUTH_TOKEN="$LITELLM_MASTER_KEY"   # Bearer auth: no login prompt, subscription login stays inactive
unset ANTHROPIC_API_KEY CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
# Only the proxy (already running) needs the Go key. Claude Code hands its
# environment to every command the model runs, so don't pass the key along.
unset OPENCODE_GO_API_KEY LITELLM_MASTER_KEY CLAUDE_GO_ANTHROPIC_BASE CLAUDE_GO_OPENAI_BASE

# --- model tiers (Claude Code's opus/sonnet/haiku aliases map onto Go models) ---
export ANTHROPIC_MODEL="${CLAUDE_GO_MODEL:-minimax-m3}"                 # --model overrides this
# The model this session starts on (a --model argument wins), for attribution.
CG_SESSION_MODEL="$ANTHROPIC_MODEL"; prev=""
for a in "$@"; do
  [[ $a == -- ]] && break
  [[ $prev == --model ]] && CG_SESSION_MODEL="$a"
  [[ $a == --model=* ]] && CG_SESSION_MODEL="${a#--model=}"
  prev="$a"
done
export ANTHROPIC_DEFAULT_OPUS_MODEL="${CLAUDE_GO_OPUS_MODEL:-kimi-k2.7-code}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${CLAUDE_GO_SONNET_MODEL:-minimax-m3}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${CLAUDE_GO_HAIKU_MODEL:-qwen3.8-flash}"  # background tasks, titles, Explore
if [[ -n ${CLAUDE_GO_SUBAGENT_MODEL:-} ]]; then export CLAUDE_CODE_SUBAGENT_MODEL="$CLAUDE_GO_SUBAGENT_MODEL"; fi
if [[ -n ${CLAUDE_GO_COMPACT_WINDOW:-} ]]; then export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$CLAUDE_GO_COMPACT_WINDOW"; fi

# --- Go client etiquette ---
# Go asks for a stable per-conversation session ID in x-opencode-session (routing +
# prompt caching). One per claude-go process; the proxy forwards x-* headers upstream.
# It forwards *every* x-* header, so an inherited ANTHROPIC_CUSTOM_HEADERS (meant for
# Anthropic, often a gateway token) is dropped: CLAUDE_GO_CUSTOM_HEADERS is the opt-in
# for headers that should reach OpenCode Go.
sid="$(cg_uuid)"
if [[ -n ${ANTHROPIC_CUSTOM_HEADERS:-} ]]; then
  cg_info "not sending ANTHROPIC_CUSTOM_HEADERS to OpenCode Go (use CLAUDE_GO_CUSTOM_HEADERS for headers meant for Go)"
fi
export ANTHROPIC_CUSTOM_HEADERS="x-opencode-session: $sid${CLAUDE_GO_CUSTOM_HEADERS:+$'\n'$CLAUDE_GO_CUSTOM_HEADERS}"

# --- compatibility with non-Anthropic backends ---
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1   # unknown anthropic-beta values make some backends 400
export CLAUDE_CODE_ATTRIBUTION_HEADER=0           # per-request fingerprint in the system prompt defeats prefix caching

# --- keep Claude Code state separate from your subscription setup ---
# (model choices made with /model here would otherwise leak into plain `claude`)
export CLAUDE_CONFIG_DIR="${CLAUDE_GO_CONFIG_DIR:-$HOME/.claude-go}"
if [[ -n $(cg_unshared_claude_items "$CLAUDE_CONFIG_DIR")$(cg_unshared_claude_settings "$CLAUDE_CONFIG_DIR") ]]; then
  cg_info "some of ~/.claude (instructions, skills or safety settings) does not apply to claude-go sessions; see: claude-go-ctl doctor"
fi

export CLAUDE_GO=1 CLAUDE_GO_SESSION="$sid"   # handy for statuslines and hooks

# --- guardrails for non-Anthropic models (config/claude-settings.json) ---
# Passed as flag settings, which outrank ~/.claude-go/settings.json and a
# repository's .claude/settings*.json. Ours go first so `--` still works.
cg_settings="$(cg_claude_settings "$CG_REPO")" || exit 1
claude_args=(--settings "$cg_settings")
# Hooks and skills that ship with claude-go (claude/plugins/*). Unlike
# --settings, --plugin-dir adds to the user's plugins instead of replacing them.
claude_args+=(--plugin-dir "$CG_REPO/claude/plugins")

if [[ $stop_on_exit == 1 && $CG_PROXY_STARTED == 1 ]]; then
  # No exec here: exec would replace this shell and the EXIT trap would never run.
  rc=0; "$claude_bin" "${claude_args[@]}" "$@" || rc=$?
  exit "$rc"
fi
exec "$claude_bin" "${claude_args[@]}" "$@"
